# ============================================================================
#  Plantilla de variables para el contenedor. Cópiala a .env.docker y edítala:
#     cp .env.docker.example .env.docker      (PowerShell: copy)
#  .env.docker está en .gitignore: NO se commitea.
#
#  REGLAS DEL FORMATO env_file de Docker (distinto de un .env de Node):
#    - sin comillas alrededor de los valores  (JWT_SECRET=abc  no  ="abc")
#    - sin espacios alrededor del =
#    - sin comentarios al final de una línea con valor
#    - no hay expansión de variables ($OTRA no se resuelve)
# ============================================================================

# ---- Servidor --------------------------------------------------------------
NODE_ENV=production
# Puerto DENTRO del contenedor. El puerto publicado al host se define en el
# -p / ports del compose. Déjalo en 3001 salvo que tengas una razón.
PORT=3001

# Saltos de proxy. Si el contenedor va detrás de nginx / Traefik / un LB, pon 1
# (o el número real de saltos) para que el rate-limit de login use la IP real
# del cliente y no la del proxy. Vacío = no confiar (expuesto directo).
TRUST_PROXY=

# ---- PostgreSQL ------------------------------------------------------------
# ¡ATENCION! Dentro del contenedor, "localhost" es el propio contenedor.
#   - BD remota / Cloud SQL por IP:  usa la IP directamente (<IP_PRIVADA_CLOUD_SQL>)
#   - PG en el HOST (Docker Desktop): host.docker.internal
#   - PG en el compose (perfil with-db): el nombre del servicio -> postgres
DATABASE_URL=postgresql://csqlim:LA_PASSWORD@<IP_PRIVADA_CLOUD_SQL>:5432/csql_inventory
PG_POOL_MAX=20
PG_IDLE_TIMEOUT=30000

# ---- Auth / seguridad ------------------------------------------------------
# COPIA ESTOS DOS VALORES TAL CUAL DE TU .env ACTUAL.
# APP_ENCRYPTION_KEY cifra la cuenta de servicio GCP guardada en BD: si cambia,
# esa credencial ya no se puede descifrar y hay que volver a subirla.
JWT_SECRET=copia-el-de-tu-.env
APP_ENCRYPTION_KEY=copia-el-de-tu-.env
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
COOKIE_MAX_AGE_MS=28800000

# Marca las cookies de sesión como Secure (solo viajan por HTTPS).
# true SOLO si sirves la app por HTTPS; con HTTP puro rompe el login.
COOKIE_SECURE=false

# Solo si algún día sirves el frontend en OTRO dominio que la API (no es el
# caso de esta imagen, que es mismo-origen). Vacío/ausente = sin CORS.
# FRONTEND_ORIGIN=https://csql.example.com

# ---- GCP -------------------------------------------------------------------
GCP_MAX_CONCURRENT_PROJECTS=10
GCP_MAX_CONCURRENT_INSTANCES=20
GCP_REQUEST_TIMEOUT=60000
# Ruta DENTRO del contenedor si montas la SA como archivo (ver Paso 8 de la
# guía). Lo normal es no usar esto y subir la SA desde la pantalla Settings.
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/service-account.json

# ---- Sync ------------------------------------------------------------------
SYNC_RATE_LIMIT_WINDOW_MS=300000
SYNC_RATE_LIMIT_MAX=1

# ---- Solo para el perfil "with-db" (PostgreSQL en un contenedor) -----------
# Deben coincidir con lo que pusiste en DATABASE_URL.
# POSTGRES_USER=csqlim
# POSTGRES_PASSWORD=pon-una-password-fuerte
# POSTGRES_DB=csql_inventory
