# Server
NODE_ENV=development
PORT=3001
# Confiar en proxy: déjalo vacío si la app se expone directo. Si va detrás de
# un reverse proxy / load balancer, pon el número de saltos (ej. 1) para que
# el rate-limiting use la IP real del cliente y no la del proxy.
TRUST_PROXY=

# PostgreSQL
DATABASE_URL=postgresql://csqlim:csqlim_dev@localhost:5432/csql_inventory
PG_POOL_MAX=20
PG_IDLE_TIMEOUT=30000

# GCP
# Option A: Service Account key file path
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
# Option B: Set automatically if running on GCP (Cloud Run, GCE, etc.)

GCP_MAX_CONCURRENT_PROJECTS=10
GCP_MAX_CONCURRENT_INSTANCES=20
GCP_REQUEST_TIMEOUT=60000

# Auth
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-use-a-long-random-string
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# Clave maestra para cifrar secretos en BD (cuenta de servicio GCP).
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ¡NO cambiar una vez en uso! (invalida los secretos ya cifrados)
APP_ENCRYPTION_KEY=change-me-32-bytes-base64

# Sync
SYNC_RATE_LIMIT_WINDOW_MS=300000
SYNC_RATE_LIMIT_MAX=1

# Frontend (Vite)
VITE_API_URL=http://localhost:3001/api
